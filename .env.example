# Copy to .env and fill in. Only GITHUB_TOKEN is needed to get started with a local Ollama.

# --- LLM ---------------------------------------------------------------------
# Option A: local Ollama (free, private). Small models are slower and less reliable with tools.
LLM_PROVIDER=ollama
LLM_MODEL=granite4:3b
LLM_BASE_URL=http://127.0.0.1:11434
LLM_NUM_CTX=16384

# Option B: any OpenAI-compatible endpoint, e.g. Groq (open-weight models, very fast):
# LLM_PROVIDER=openai
# LLM_MODEL=openai/gpt-oss-20b
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...

# --- GitHub MCP server ---------------------------------------------------------
# Fine-grained personal access token with "Public repositories (read-only)" access.
# Empty = GitHub tools (issues, PRs, commits, releases) disabled; code questions still work.
GITHUB_TOKEN=
# stdio  : run the github-mcp-server binary (download it, see docs/SETUP.md)
# docker : run ghcr.io/github/github-mcp-server with Docker Desktop
# remote : GitHub's hosted server (https://api.githubcopilot.com/mcp/)
# http   : your own `github-mcp-server http` at GITHUB_MCP_URL
GITHUB_MCP_MODE=stdio
GITHUB_MCP_COMMAND=tools/github-mcp-server.exe
# GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/

# --- Codebase MCP server (ours: shallow clone, grep, line-range reads) -----------
CODEBASE_CACHE_DIR=.cache/repos
CODEBASE_CACHE_TTL_S=3600
CODEBASE_MAX_REPO_MB=300

# --- Agent ----------------------------------------------------------------------
MAX_TOOL_CALLS=8
MAX_TOOL_OUTPUT_CHARS=6000

# --- API --------------------------------------------------------------------------
# Set before exposing the API anywhere: every request then needs the X-API-Key header.
API_KEY=
LOG_LEVEL=INFO
